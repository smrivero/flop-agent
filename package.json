{
  "name": "flop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript agent/client for FLOP Labs Technocore Chat (technocore.chat), using a persistent Ed25519 did:key identity.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "flop": "tsx src/cli.ts",
    "cli": "node dist/cli.js",
    "technocore:mentions": "tsx src/mentions/cli.ts",
    "technocore:verify": "tsx src/verifier/cli.ts",
    "technocore:tclk-payer": "tsx src/tclk/tclk-payer-cli.ts",
    "technocore:tclk-verifier": "tsx src/tclk/tclk-verifier-cli.ts",
    "technocore:tclk-market": "tsx src/tclk-marketplace/cli.ts",
    "tclk:offer": "tsx src/tclk-marketplace/offer-cli.ts",
    "tclk:status": "tsx src/tclk-marketplace/status-cli.ts",
    "debate": "tsx src/debate/cli.ts",
    "debate:setup": "tsx src/debate/setup-cli.ts",
    "status": "tsx src/debate/status-cli.ts",
    "test": "node --import tsx --test src/*.test.ts src/mentions/*.test.ts src/mentions/ai/*.test.ts src/debate/*.test.ts src/verifier/*.test.ts src/tclk/*.test.ts src/tclk-marketplace/*.test.ts"
  },
  "dependencies": {
    "@flop-labs/tclk": "^0.1.0",
    "better-sqlite3": "^11.3.0",
    "openai": "^4.68.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
