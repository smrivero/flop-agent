{
  "name": "flop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript agent/client for FLOP Labs Technocore Chat (technocore.chat), using a persistent Ed25519 did:key identity.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "flop": "tsx src/cli.ts",
    "cli": "node dist/cli.js",
    "technocore:mentions": "tsx src/mentions/cli.ts",
    "technocore:verify": "tsx src/verifier/cli.ts",
    "technocore:tclk-payer": "tsx src/tclk/tclk-payer-cli.ts",
    "technocore:tclk-verifier": "tsx src/tclk/tclk-verifier-cli.ts",
    "technocore:tclk-market": "tsx src/tclk-marketplace/cli.ts",
    "tclk:offer": "tsx src/tclk-marketplace/offer-cli.ts",
    "tclk:status": "tsx src/tclk-marketplace/status-cli.ts",
    "debate": "tsx src/debate/cli.ts",
    "debate:setup": "tsx src/debate/setup-cli.ts",
    "status": "tsx src/debate/status-cli.ts",
    "sonnet:preflight": "tsx src/sonnet/cli.ts preflight",
    "sonnet:scan": "tsx src/sonnet/cli.ts scan",
    "sonnet:register": "tsx src/sonnet/cli.ts register",
    "sonnet:recruit": "tsx src/sonnet/cli.ts recruit",
    "sonnet:join": "tsx src/sonnet/cli.ts join",
    "sonnet:team": "tsx src/sonnet/cli.ts team",
    "sonnet:roster": "tsx src/sonnet/cli.ts roster",
    "sonnet:propose": "tsx src/sonnet/cli.ts propose",
    "sonnet:run": "tsx src/sonnet/cli.ts run",
    "protocol:watch": "tsx src/protocol-watcher/cli.ts watch",
    "protocol:watch:dry": "tsx src/protocol-watcher/cli.ts watch --dry-run",
    "protocol:status": "tsx src/protocol-watcher/cli.ts status",
    "protocol:diff": "tsx src/protocol-watcher/cli.ts diff",
    "protocol:baseline": "tsx src/protocol-watcher/cli.ts baseline",
    "protocol:test-notify": "tsx src/protocol-watcher/cli.ts test-notify",
    "protocol:retry-notify": "tsx src/protocol-watcher/cli.ts retry-notify",
    "closecall:run": "tsx src/close-call/cli.ts run",
    "closecall:paper": "tsx src/close-call/cli.ts paper",
    "closecall:observe": "tsx src/close-call/cli.ts observe",
    "closecall:dry-run": "tsx src/close-call/cli.ts dry-run",
    "closecall:status": "tsx src/close-call/cli.ts status",
    "closecall:health": "tsx src/close-call/cli.ts health",
    "closecall:positions": "tsx src/close-call/cli.ts positions",
    "closecall:leaderboard": "tsx src/close-call/cli.ts leaderboard",
    "closecall:keys": "tsx src/close-call/cli.ts keys",
    "closecall:pending": "tsx src/close-call/cli.ts pending",
    "closecall:report": "tsx src/close-call/cli.ts report",
    "closecall:reconcile": "tsx src/close-call/cli.ts reconcile",
    "closecall:backup": "tsx src/close-call/cli.ts backup",
    "closecall:restore-check": "tsx src/close-call/cli.ts restore-check",
    "closecall:unhalt": "tsx src/close-call/cli.ts unhalt",
    "closecall:bootstrap-plan": "tsx src/close-call/cli.ts bootstrap-plan",
    "test": "node --import tsx --test src/*.test.ts src/mentions/*.test.ts src/mentions/ai/*.test.ts src/debate/*.test.ts src/verifier/*.test.ts src/tclk/*.test.ts src/tclk-marketplace/*.test.ts src/protocol-watcher/*.test.ts src/protocol-watcher/normalize/*.test.ts src/protocol-watcher/extract/*.test.ts src/protocol-watcher/summary/*.test.ts src/protocol-watcher/notify/*.test.ts src/sonnet/*.test.ts src/close-call/*.test.ts src/close-call/strategy/*.test.ts",
    "test:sonnet": "node --import tsx --test src/sonnet/*.test.ts",
    "test:closecall": "node --import tsx --test src/close-call/*.test.ts src/close-call/strategy/*.test.ts"
  },
  "dependencies": {
    "@flop-labs/tclk": "^0.1.0",
    "better-sqlite3": "^11.3.0",
    "node-html-parser": "^7.1.0",
    "openai": "^4.68.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
