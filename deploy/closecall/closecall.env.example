# /etc/flop-closecall/closecall.env  (root:flopcc 0640). Never commit the real file.
# The installer creates this file ONLY if it does not exist; it never overwrites it.

# ---- mode ---------------------------------------------------------------
# paper = observer + strategy + paper executor on FAKE keys. No signing, no writes to Technocore.
CLOSECALL_MODE=paper
# Live needs CLOSECALL_MODE=live AND CLOSECALL_LIVE_ENABLED=<exact ack>; this build refuses live anyway.
# CLOSECALL_LIVE_ENABLED=

# ---- paths (the unit also pins CLOSECALL_DATA_DIR) ------------------------
CLOSECALL_DATA_DIR=/var/lib/flop-closecall
CLOSECALL_PYTHON=/usr/bin/python3

# ---- endpoints ------------------------------------------------------------
CLOSECALL_TECHNOCORE_URL=https://technocore.chat
CLOSECALL_HL_INFO_URL=https://api.hyperliquid.xyz/info

# ---- strategy / policies ----------------------------------------------------
CLOSECALL_KEY_COUNT=100
CLOSECALL_STALE_POLICY=adaptive
CLOSECALL_CONFIRMATION_POLICY=STRICT
CLOSECALL_ROOM_REFRESH_DAYS=5

# ---- health server (localhost only; use an SSH tunnel) ------------------------
CLOSECALL_HEALTH_ENABLED=true
CLOSECALL_HEALTH_HOST=127.0.0.1
CLOSECALL_HEALTH_PORT=8787

# ---- logs -------------------------------------------------------------------
CLOSECALL_LOG_MAX_FILE_MB=20
CLOSECALL_LOG_MAX_TOTAL_MB=500
CLOSECALL_LOG_RETENTION_DAYS=14
CLOSECALL_DISK_LOW_MB=500

# ---- alerts (optional; empty = log + sqlite only) ------------------------------
CLOSECALL_ALERT_WEBHOOK_URL=
CLOSECALL_ALERT_TELEGRAM_BOT_TOKEN=
CLOSECALL_ALERT_TELEGRAM_CHAT_ID=
CLOSECALL_ALERT_MIN_INTERVAL_S=900

# ---- backups (scripts/closecall-backup.sh) ---------------------------------------
# age public key (age1...) of a key that lives on YOUR Mac, not on the VPS. Empty = keys are NOT backed up.
CLOSECALL_BACKUP_AGE_RECIPIENT=
CLOSECALL_BACKUP_KEEP=48
