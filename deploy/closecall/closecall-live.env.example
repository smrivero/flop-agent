# /etc/flop-closecall/closecall-live.env  (root:flopcc 0640) -- the LIVE service only. Never commit the real file.
# Start from a copy of closecall.env, then set/override these. `flop-closecall live-check` must say PASS.

CLOSECALL_MODE=live
# The exact acknowledgement (see src/close-call/config.ts LIVE_ACK). Without it the service refuses to start.
CLOSECALL_LIVE_ENABLED=I-UNDERSTAND-CLOSECALL-LIVE-SIGNS-AND-POSTS-REAL-MESSAGES

# Live has its OWN database, lock, logs and health port: the paper service keeps running beside it.
CLOSECALL_DATA_DIR=/var/lib/flop-closecall
CLOSECALL_DB_PATH=/var/lib/flop-closecall/live.sqlite3
CLOSECALL_LIVE_DB_PATH=/var/lib/flop-closecall/live.sqlite3
CLOSECALL_LOCK_PATH=/var/lib/flop-closecall/live.lock
CLOSECALL_LOG_DIR=/var/lib/flop-closecall/logs-live
CLOSECALL_RAW_DIR=/var/lib/flop-closecall/logs-live
CLOSECALL_HEALTH_PORT=8788

CLOSECALL_ROOM=
CLOSECALL_CONFIRMATION_POLICY=PROTOCOL
CLOSECALL_ESTIMATOR=hl
CLOSECALL_KEY_COUNT=100
CLOSECALL_POST_GUARD_MS=3000
CLOSECALL_WRITE_BUDGET_FRACTION=0.25
CLOSECALL_BACKUP_AGE_RECIPIENT=
CLOSECALL_PYTHON=/usr/bin/python3
