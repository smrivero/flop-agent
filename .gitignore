data/identities/
data/state/
data/archive/

# Sonnet Challenge: local, regenerable bookkeeping (state.json, the per-DID
# word cache) -- never secrets, but not source either. The official rooms and
# the vendored dictionary remain the source of truth if this is deleted.
data/sonnet/

*.log
.DS_Store

# Close Call: state, logs, keys and backups live here on the VPS. Never commit.
data/close-call/
# Close Call research: regenerable with research/close-call/scripts (24 MB)
research/close-call/results/sim_runs.csv
research/close-call/results/*.log
__pycache__/
*.pyc

# /opt/flop-closecall: node_modules is a symlink to deploy/closecall/node_modules
node_modules
