# Which Technocore instance to talk to.
TECHNOCORE_URL=https://technocore.chat

# Default nickname for the unsigned lane when no --nick flag is given.
# Irrelevant once a signed identity is loaded (the DID becomes `from`).
TECHNOCORE_NICK=

# Where the local identity file lives. Never commit the real file --
# it is already covered by .gitignore via the .technocore/ directory.
TECHNOCORE_IDENTITY_PATH=.technocore/identity.json

# ---------------------------------------------------------------------------
# technocore:mentions (Technocore Radar) -- see README.md "Mentions pipeline"
# for the full guide
# ---------------------------------------------------------------------------

# Search
SEARCH_PROVIDER=tavily

TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=10

SEARXNG_URL=http://localhost:8888

SEARCH_QUERIES=Technocore FLOP|technocore.chat|Technocore AI agents|FLOP Labs Technocore|Technocore inference
QUERIES_PER_RUN=2

# OpenAI (all optional -- see the README for what each combination does).
# This task is small (confirm it's not a different "Technocore", extract 1-2
# factual sentences) -- a small/cheap model is enough, no need for a
# reasoning-heavy one. gpt-5-nano is a reasonable default if your account has
# it; use whatever cheap model you have.
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
FILTER_WITH_OPENAI=false
GENERATE_SUMMARY=false
MAX_CONTENT_CHARS=12000

# Technocore room this pipeline posts findings into
TECHNOCORE_ROOM=d-technocore-links

# Publishing
MAX_POSTS_PER_RUN=5
INCLUDE_OFFICIAL_SOURCES=false
EXCLUDED_DOMAINS=

# Show a short (8 hex char) form of the finding's content hash in the public
# message (`Evidence: sha256:...`). The full hash is always stored in SQLite
# regardless -- this only controls whether the short form is also visible.
PUBLISH_CONTENT_HASH=false

# At most once per 24h, publish REAL aggregated activity numbers (searches,
# results inspected, duplicates, new findings) from the run log. Off by
# default -- never a per-run heartbeat, never invented numbers.
PUBLISH_DAILY_STATUS=false

# Mirror {last_run, last_finding, total_findings} to a small Technocore note
# as public, checkable evidence of activity. SQLite stays the source of truth
# either way -- this is a courtesy copy, not read back by this project.
PUBLISH_RADAR_STATE=false

# Network
HTTP_TIMEOUT_MS=15000
MAX_RETRIES=2

# Failure behavior: if OpenAI analysis errors out, publish anyway (unfiltered,
# no finding text) rather than silently dropping the mention. Set to false to
# skip instead.
PUBLISH_IF_ANALYSIS_FAILS=true

# Where the mentions SQLite DB and the cron concurrency lock file live.
# Both are gitignored (.data/) -- change only if you need a different location.
MENTIONS_DB_PATH=.data/mentions.sqlite3
MENTIONS_LOCK_PATH=.data/mentions.lock

# ---------------------------------------------------------------------------
# verifier -- Technocore Verifier, a second, independent process that re-checks
# findings Technocore Radar already published. See README.md "Findings and
# independent verification". Signs with a SEPARATE identity (Agent B) from
# Radar's own .technocore/identity.json -- never the same DID, checked at
# startup on every run. Reads/writes the SAME database as mentions
# (MENTIONS_DB_PATH above), just one more table in it.
# ---------------------------------------------------------------------------

VERIFIER_ENABLED=true

# At most this many pending findings get analyzed (and, on success, an OpenAI
# call spent) per run -- keeps a stray cron overlap or a big backlog bounded.
VERIFIER_MAX_PER_RUN=2

# Fraction (0-1) of eligible findings actually verified per run, for cost
# control at scale. 1 = verify everything eligible (the default).
VERIFIER_SAMPLE_RATE=1

# Falls back to OPENAI_MODEL above if unset. Uses the same OPENAI_API_KEY.
VERIFIER_MODEL=gpt-5-nano

# Agent B's identity file -- generate it the same manual way as identity.json
# (node scripts/generate-identity.mjs), just to a different path. Must never
# be the same file (or the same underlying key) as TECHNOCORE_IDENTITY_PATH --
# the Verifier checks this at startup and refuses to publish if they match.
VERIFIER_IDENTITY_PATH=.technocore/identityB.json

# Single-instance guard for cron, same idea as MENTIONS_LOCK_PATH.
VERIFIER_LOCK_PATH=.data/verifier.lock

# ---------------------------------------------------------------------------
# tclk -- Agent A (Radar/payer) <-> Agent B (Verifier/payee) coordination over
# @flop-labs/tclk (tclk/1), instead of the two pipelines only ever meeting
# through shared SQLite. See README.md "TCLK coordination" for the full guide
# and the two new commands this adds: technocore:tclk-payer, technocore:tclk-verifier.
# ---------------------------------------------------------------------------

TCLK_ENABLED=false

# Only "paper" exists today (PaperRail -- settles nothing, rehearses the
# lock/claim/refund lifecycle on real Technocore infrastructure). Do not set
# this to anything else; no value-bearing rail is wired up.
TCLK_RAIL=paper

# Deadlines, as minutes from the moment Radar opens the offer. tclk requires
# claimByMs < refundAfterMs strictly -- CLAIM_MINUTES must stay below
# REFUND_MINUTES.
TCLK_OFFER_EXPIRES_MINUTES=30
TCLK_CLAIM_MINUTES=60
TCLK_REFUND_MINUTES=120

# PaperRail moves no value -- these exist only to exercise the offer's
# amount/asset fields. Matches examples/live-deal.mjs exactly for maximum
# compatibility with the reference implementation; PAPER/paper are also what
# PaperRail's own rail id is hardcoded to, so don't change TCLK_RAIL to match
# a different asset name -- they're independent fields.
TCLK_AMOUNT=1000000
TCLK_ASSET=PAPER

# The payer DID Agent B will accept offers from. Leave unset to derive it
# automatically from TECHNOCORE_IDENTITY_PATH (Radar's own identity) at
# startup -- only set this explicitly if Agent B should trust a payer whose
# identity file isn't the one this same .env points TECHNOCORE_IDENTITY_PATH at.
TCLK_ALLOWED_PAYER_DID=

# Where Agent B custodies the preimage it mints at ACCEPT time until REVEAL.
# Deliberately NOT the shared mentions database -- a separate, restricted
# (chmod 0600) file, gitignored via .technocore/ like the identity files.
# Never logged, never written to Technocore before the reveal itself.
TCLK_SECRETS_PATH=.technocore/tclk-secrets.sqlite3

# Single-instance guards for the two new cron commands, same idea as
# MENTIONS_LOCK_PATH / VERIFIER_LOCK_PATH.
TCLK_PAYER_LOCK_PATH=.data/tclk-payer.lock
TCLK_VERIFIER_LOCK_PATH=.data/tclk-verifier.lock

# ---------------------------------------------------------------------------
# TCLK Marketplace Worker -- a THIRD, fully independent flow (src/tclk-marketplace/),
# separate from both radar/mentions+debate AND from the private tclk/ pair above.
# Monitors the PUBLIC tclk-offers room, accepts offers from ANY counterparty
# subject to the policy below, runs a whitelisted job, reveals, and can publish
# its own offers. See README.md "TCLK Marketplace Worker" for the full guide.
# Every var here is its own `TCLK_MKT_*` namespace -- none of it reuses or
# affects TCLK_ENABLED / TCLK_RAIL / TCLK_AMOUNT / etc above, which govern the
# OTHER (private Radar<->Verifier) flow. Disabling this worker (ENABLE_TCLK=false,
# the default) has zero effect on radar/mentions, debate, or the tclk/ pair.
# ---------------------------------------------------------------------------

# Master switch for this worker specifically. Distinct from TCLK_ENABLED on
# purpose -- see the note above.
ENABLE_TCLK=false

# Preview mode: read rooms, decode offers, evaluate policy, reconstruct
# contract state, log what action WOULD be taken -- but never post an accept/
# offer/lock/reveal/refund/receipt frame and never call the rail. Safe to run
# against the real, public tclk-offers room at any time. Also settable per-run
# with `--dry-run` on any of the three CLIs below.
TCLK_MKT_DRY_RUN=true

# Identity this worker signs with. Defaults to TECHNOCORE_IDENTITY_PATH (Radar's
# own identity) -- set this only if the marketplace worker should act as a
# DIFFERENT local identity than radar/mentions.
TCLK_MKT_IDENTITY_PATH=

# The public rendezvous room (SPEC.md "Rendezvous"). Leave this as the library
# default unless you're testing against a private, non-production room --
# changing it means you can no longer see or be seen by real counterparties.
TCLK_MKT_OFFER_ROOM=tclk-offers

# Only "paper" exists today -- see the TCLK_RAIL note above, same caveat.
TCLK_MKT_RAIL=paper

TCLK_MKT_DB_PATH=.data/tclk-marketplace.sqlite3
TCLK_MKT_SECRETS_PATH=.technocore/tclk-market-secrets.sqlite3
TCLK_MKT_LOCK_PATH=.data/tclk-market.lock

# -- Offer Policy Engine (shouldAcceptOffer) --------------------------------
# No offer is ever auto-accepted unless EVERY one of these passes. Off by
# default -- flip to true deliberately, after reviewing the rest of this block.
TCLK_MKT_AUTO_ACCEPT=false
TCLK_MKT_MAX_CONCURRENT_DEALS=2
TCLK_MKT_MIN_AMOUNT=0
# Reject an offer whose claim window (claimByMs - now) implies a job would
# have to run longer than this to be claimed safely.
TCLK_MKT_MAX_JOB_DURATION_MS=900000
TCLK_MKT_ALLOWED_ASSETS=PAPER,FLOP
# Must match a rail id the counterparty's offer actually lists -- PaperRail's
# own id is literally "paper" (not "flop-htlc"/"x402"/etc, those need a
# value-bearing rail this project doesn't implement yet).
TCLK_MKT_ALLOWED_RAILS=paper
# Whitelist of job.proto values the executor (executor.ts) will actually run.
# Anything else is rejected before acceptance, and re-checked (defense in
# depth) right before the job would run. "echo" is fully side-effect-free;
# research-test/verification-test are safe stubs in this first version (no
# external calls) -- see executor.ts.
TCLK_MKT_SUPPORTED_JOB_TYPES=echo,research-test,verification-test
# Optional: comma-separated DIDs. Empty (default) = accept from any
# counterparty DID, which is the point of a public marketplace.
TCLK_MKT_ALLOWED_COUNTERPARTY_DIDS=

# -- Offer Publisher (this worker acting as payer) --------------------------
TCLK_MKT_AUTO_PUBLISH=false
TCLK_MKT_MAX_OPEN_OFFERS=3
TCLK_MKT_MIN_OFFER_INTERVAL_MS=3600000
TCLK_MKT_OFFER_AMOUNT=1000000
TCLK_MKT_OFFER_ASSET=PAPER
TCLK_MKT_OFFER_JOB_TYPE=echo
TCLK_MKT_OFFER_EXPIRES_MINUTES=30
TCLK_MKT_CLAIM_MINUTES=60
TCLK_MKT_REFUND_MINUTES=120

# -- Polling / rate limiting --------------------------------------------------
# Long-poll wait on each tclk-offers read (0-10s, technocore's own cap) --
# NOT a sleep; this is what avoids tight polling. Per-deal-room reads inside
# one tick use wait=0 (they're already bounded by the outer cadence below).
TCLK_MKT_LONG_POLL_WAIT_SECONDS=10
# Sleep between ticks once a tick with no error completes (the worker loop --
# not used by --once).
TCLK_MKT_POLL_INTERVAL_MS=15000
# Cap on the exponential backoff a tick-level failure triggers (schedule:
# 1s, 2s, 5s, 10s, 30s, then holds here).
TCLK_MKT_MAX_BACKOFF_MS=30000

TCLK_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# debate -- two autonomous agents debating in a Technocore room. See README.md
# "Autonomous debate service" for the full guide. Uses OPENAI_API_KEY /
# OPENAI_MODEL / HTTP_TIMEOUT_MS / MAX_RETRIES above -- no separate keys needed.
# ---------------------------------------------------------------------------

# Which inference backend generates turns. Only "openai" exists today -- the
# orchestrator depends on the InferenceProvider interface (src/debate/inference.ts),
# not on the OpenAI SDK directly, so a future FLOP provider is a new class plus
# this value changing, nothing else. Do not set this to anything but "openai"
# yet -- there is no FLOP inference API/testnet to point it at.
INFERENCE_PROVIDER=openai

# Bound on generated-tokens per turn (cost control; keep this well below your
# model's max so a runaway response can't happen).
OPENAI_MAX_OUTPUT_TOKENS=900

# Which Technocore instance the debate service talks to (independent of the
# base CLI's hardcoded default, matching this feature's own requested config).
TECHNOCORE_BASE_URL=https://technocore.chat

# The conversation definition -- room, topic, personalities. Not a secret;
# lives outside .env on purpose. See config/debate.yaml.
DEBATE_CONFIG=./config/debate.yaml

# Each agent's own persistent Ed25519 identity. Loaded if the file exists,
# generated (once) if it doesn't -- never regenerated just because the process
# restarted, the topic changed, personalities changed, or the room changed.
# Never commit these paths' contents: data/identities/ is gitignored.
AGENT_A_IDENTITY_PATH=./data/identities/agent-a.json
AGENT_B_IDENTITY_PATH=./data/identities/agent-b.json

# One new message roughly every MIN..MAX seconds (a random interval is chosen
# fresh after every successful post) -- 2-6 hours by default. The original
# 1-5 MINUTE defaults made this a spam bot, not a persistent discussion.
MIN_DELAY_SECONDS=7200
MAX_DELAY_SECONDS=21600

# Hard cap on PUBLISHED debate messages per UTC day (checkpoints count,
# skipped turns do not). Once reached, no more turns are generated until the
# day rolls over -- never a burst of catch-up messages.
MAX_MESSAGES_PER_DAY=4

# When true, the model may return exactly "SKIP" instead of a message when it
# has nothing new or useful to add -- logged, never signed, never published,
# and never counted toward MAX_MESSAGES_PER_DAY.
ALLOW_SKIP_TURN=true

# How many of the most recent agent-signed room messages to feed back to the
# model as conversation context.
HISTORY_MESSAGES=12

# Hard cap on a generated message's length, enforced by sanitize.ts before
# signing (the protocol's own single-message cap is 4096; this is the debate's
# own, tighter "keep it conversational" cap). The actual per-turn target is
# usually much shorter -- see RESPONSE MODE in loop.ts/responseMode.ts, chosen
# fresh every turn so messages don't all grow toward this ceiling.
MAX_MESSAGE_CHARS=3500

# Jaccard word-trigram similarity (0-1) above which a draft is considered too
# close to that same agent's own recent messages (see RECENT_MESSAGES_FOR_SIMILARITY
# below) and gets exactly ONE regeneration attempt with an explicit "be
# different" instruction. Still too similar on the second try -> the turn is
# skipped entirely (never force-published). No API call needed to run the
# check itself -- only the at-most-one regeneration costs a call.
REPETITION_THRESHOLD=0.45
RECENT_MESSAGES_FOR_SIMILARITY=8

# Whether turns use OpenAI's hosted web_search tool.
WEB_SEARCH_ENABLED=true

# When true (requires WEB_SEARCH_ENABLED=true too), tool_choice is forced to
# "required" and the response is inspected for an actual web_search_call --
# a turn without one is rejected and retried later rather than published with
# unverified facts.
WEB_SEARCH_REQUIRED=true

# Every Nth successfully published message, one agent posts a short, locally
# formatted "DEBATE CHECKPOINT" (claims checked/verified/disputed/corrected)
# instead of a normal reply -- no extra OpenAI call, just a summary of local
# claim state. Off entirely if CHECKPOINT_ENABLED=false.
CHECKPOINT_ENABLED=true
CHECKPOINT_EVERY_MESSAGES=10

# Periodically saves the room's full signed history locally via the real
# Technocore export endpoint (GET /r/<room>/export), plus a SHA-256 sidecar --
# see README "Room archival". Runs on its own schedule, independent of the
# debate cadence; a failure here never affects message generation.
ARCHIVE_ENABLED=true
ARCHIVE_INTERVAL_HOURS=24

# Periodically re-writes each agent's own DID note (a plain, unsigned
# `/kv/did-<shard>/<key>` write of the bare DID -- see README "Identity
# maintenance") so it doesn't get reaped by Technocore's "no write for 7 days"
# deletion policy. Entirely separate from debate messages -- never posts to
# the debate room. 72h default leaves a comfortable margin inside the 7-day window.
IDENTITY_MAINTENANCE_ENABLED=true
IDENTITY_REFRESH_HOURS=72

LOG_LEVEL=info

# Local memory (recent arguments, claim history, daily counters) and the
# cron-style single-instance lock. Both gitignored (data/state/) -- change
# only if you need a different location.
DEBATE_STATE_PATH=./data/state
DEBATE_LOCK_PATH=./data/state/debate.lock

# Where periodic room archives (see ARCHIVE_ENABLED above) are written.
# Gitignored, lives under the same ./data volume mount as everything else.
DEBATE_ARCHIVE_PATH=./data/archive

# ---------------------------------------------------------------------------
# FLOP Protocol Watcher (src/protocol-watcher/) -- monitors the official FLOP
# documentation (see config/protocol-sources.yaml for the URL list) for real
# changes and raises alerts. Completely independent of radar/mentions,
# verifier, debate, tclk/ and tclk-marketplace/ -- its own SQLite file, its
# own lock, its own logger. See README.md "FLOP Protocol Watcher" for the
# full guide and cron example.
# ---------------------------------------------------------------------------

# Master switch. false (the default) means `npm run protocol:watch` exits
# immediately without fetching anything. `npm run protocol:watch:dry` always
# runs regardless of this flag -- dry-run never sends a notification, so
# there's no reason to gate it behind the master switch too.
PROTOCOL_WATCHER_ENABLED=false

# Documented cadence for the cron example below -- this file does not itself
# schedule anything.
PROTOCOL_WATCHER_INTERVAL_HOURS=6

# New integration -- no Telegram code exists anywhere else in this project.
# Off by default; sending is a single attempt (no retry) to avoid a
# double-post on a timeout, same rationale as the existing Technocore
# publisher.
PROTOCOL_WATCHER_TELEGRAM_ENABLED=false
PROTOCOL_WATCHER_TELEGRAM_BOT_TOKEN=
PROTOCOL_WATCHER_TELEGRAM_CHAT_ID=

# Optional signed Technocore publish, using Agent A's EXISTING identity
# (TECHNOCORE_IDENTITY_PATH above) -- never a new DID. Off by default. Never
# publishes a cosmetic-only change, never the full document, and at most one
# summary per source per run. This project never creates or joins the room
# for you.
PROTOCOL_WATCHER_TECHNOCORE_ENABLED=false
PROTOCOL_WATCHER_TECHNOCORE_ROOM=d-flop-protocol-watch

# Optional short LLM rewording of an already-computed diff (see
# summary/llm.ts) -- the model is only ever shown that structured diff, never
# a raw fetched page. Off by default; a deterministic summary is always the
# fallback (LLM disabled, missing keys, or a failed call all fall back the
# same way, without blocking the run). Reuses OPENAI_API_KEY / OPENAI_MODEL
# from above -- no separate key needed.
PROTOCOL_WATCHER_LLM_SUMMARY_ENABLED=false

# Network: per-request timeout, retry count (network errors / 5xx only, never
# 4xx), redirect cap, and a response-size cap (bytes) so a hostile or
# misconfigured server can't hang this or exhaust memory.
PROTOCOL_WATCHER_REQUEST_TIMEOUT_MS=15000
PROTOCOL_WATCHER_MAX_RETRIES=2
PROTOCOL_WATCHER_MAX_REDIRECTS=5
PROTOCOL_WATCHER_MAX_RESPONSE_BYTES=10000000

# How long a superseded snapshot (not the latest for its source, not
# referenced by any recorded change) is kept before its row and content
# files are pruned.
PROTOCOL_WATCHER_RETENTION_DAYS=180

# Where the source registry, SQLite DB, concurrency lock and raw/normalized
# content cache live. All gitignored under .data/ except the source registry,
# which is intentionally version-controlled (config/protocol-sources.yaml).
PROTOCOL_WATCHER_SOURCES_PATH=config/protocol-sources.yaml
PROTOCOL_WATCHER_DB_PATH=.data/protocol-watcher.sqlite3
PROTOCOL_WATCHER_LOCK_PATH=.data/protocol-watcher.lock
PROTOCOL_WATCHER_CONTENT_DIR=.data/protocol-watcher-content
