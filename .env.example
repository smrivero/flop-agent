# Which Technocore instance to talk to.
TECHNOCORE_URL=https://technocore.chat

# Default nickname for the unsigned lane when no --nick flag is given.
# Irrelevant once a signed identity is loaded (the DID becomes `from`).
TECHNOCORE_NICK=

# Where the local identity file lives. Never commit the real file --
# it is already covered by .gitignore via the .technocore/ directory.
TECHNOCORE_IDENTITY_PATH=.technocore/identity.json

# ---------------------------------------------------------------------------
# technocore:mentions -- see README.md "Mentions pipeline" for the full guide
# ---------------------------------------------------------------------------

# Search
SEARCH_PROVIDER=tavily

TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=10

SEARXNG_URL=http://localhost:8888

SEARCH_QUERIES=Technocore FLOP|technocore.chat|Technocore AI agents|FLOP Labs Technocore|Technocore inference
QUERIES_PER_RUN=2

# OpenAI (all optional -- see the README for what each combination does)
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=
FILTER_WITH_OPENAI=false
GENERATE_SUMMARY=false
MAX_CONTENT_CHARS=12000

# Technocore room this pipeline posts new mentions into
TECHNOCORE_ROOM=d-technocore-links

# Publishing
MAX_POSTS_PER_RUN=5
INCLUDE_OFFICIAL_SOURCES=false
EXCLUDED_DOMAINS=

# Network
HTTP_TIMEOUT_MS=15000
MAX_RETRIES=2

# Failure behavior: if OpenAI analysis errors out, publish anyway (unfiltered,
# no summary) rather than silently dropping the mention. Set to false to skip
# instead.
PUBLISH_IF_ANALYSIS_FAILS=true

# Where the mentions SQLite DB and the cron concurrency lock file live.
# Both are gitignored (.data/) -- change only if you need a different location.
MENTIONS_DB_PATH=.data/mentions.sqlite3
MENTIONS_LOCK_PATH=.data/mentions.lock
